{
  "expo": {
    "name": "KA Wedding",
    "slug": "ka-wedding",
    "scheme": "kawedding",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCFAF5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kashikaarjun.wedding",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kashikaarjun.wedding",
      "adaptiveIcon": {
        "backgroundColor": "#FCFAF5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFAF5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used for your wedding disposable camera: 27 photos a day, shared with the other guests the next morning.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Lets you save wedding photos from the album to your phone.",
          "photosPermission": "Lets you save wedding photos from the album to your phone."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#AA4E6D"
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Lets the app welcome you with a notification when you reach Chandigarh and when you arrive at the resort. Your location stays on your phone and is never sent to anyone.",
          "locationWhenInUsePermission": "Lets the app welcome you with a notification when you reach Chandigarh and when you arrive at the resort. Your location stays on your phone and is never sent to anyone.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "The microphone is used to record voice notes you send in the wedding chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you pick photos to send in the wedding chat, or to add your ID and tickets for travel.",
          "cameraPermission": "The camera is used for your wedding disposable camera, for photos you send in chat, and to photograph your ID or tickets for travel.",
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "51479f1e-2e56-4e74-a020-06a240df13ab"
      }
    },
    "owner": "arjun.panchal",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/51479f1e-2e56-4e74-a020-06a240df13ab"
    }
  }
}
